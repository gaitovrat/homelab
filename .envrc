if ! has nix_direnv_version || ! nix_direnv_version 3.2.0; then
  source_url "https://raw.githubusercontent.com/nix-community/nix-direnv/3.2.0/direnvrc" "sha256-hW6NC1JHue3IjZN3uDM6l6I2PMaauqd2D7hXYJ1Zfr4="
fi
use flake
watch_file .github/requirements-lint.txt

export KUBECONFIG="$PWD/.kube/config"

# On WSL, ssh goes through Windows: ssh.exe gets the node key from the 1Password SSH agent
# and reaches the nodes over the Windows Tailscale app. Windows OpenSSH can't multiplex
# connections, so drop Ansible's default ControlMaster/ControlPersist.
if has ssh.exe; then
  export ANSIBLE_SSH_EXECUTABLE=ssh.exe
  export ANSIBLE_SSH_ARGS="-C"
fi
