# Dev shell from the repo root, plus credentials for this stack only: direnv unloads them
# when you leave this directory, so the rest of the repo never sees them.
source_up

# Cloudflare API token, account ID and R2 state key from 1Password (see README), under the
# same names as the homelab repo's GitHub Actions secrets. One op call, so 1Password asks
# at most once. On WSL, the Windows op.exe talks to the 1Password app (Windows Hello); a
# Linux op can't.
vault="${HOMELAB_OP_VAULT:-Homelab}"
op=op
if has op.exe; then
  op=op.exe
fi

if env="$("$op" inject <<TEMPLATE
CLOUDFLARE_API_TOKEN={{ op://$vault/homelab-cloudflare-terraform/credential }}
CLOUDFLARE_ACCOUNT_ID={{ op://$vault/homelab-cloudflare-terraform/account_id }}
AWS_ACCESS_KEY_ID={{ op://$vault/homelab-tfstate-r2/username }}
AWS_SECRET_ACCESS_KEY={{ op://$vault/homelab-tfstate-r2/password }}
TEMPLATE
)"; then
  while IFS='=' read -r name value; do
    export "$name=${value%$'\r'}" # op.exe ends lines with CRLF
  done <<<"$env"

  # The S3 backend's R2 endpoint.
  export AWS_ENDPOINT_URL_S3="https://$CLOUDFLARE_ACCOUNT_ID.r2.cloudflarestorage.com"
else
  log_error "homelab: couldn't read Cloudflare credentials from 1Password; tofu will fail. Run 'direnv reload' to retry."
fi
