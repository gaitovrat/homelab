source_up

vault="${HOMELAB_OP_VAULT:-Homelab}"
op=op
if has op.exe; then
  op=op.exe
fi

if env="$("$op" inject <<TEMPLATE
CLOUDFLARE_API_TOKEN={{ op://$vault/Terraform Cloudflare Token/password }}
CLOUDFLARE_ACCOUNT_ID={{ op://$vault/R2 Tfstate Bucket/username }}
AWS_ACCESS_KEY_ID={{ op://$vault/R2 Tfstate Bucket/account key id }}
AWS_SECRET_ACCESS_KEY={{ op://$vault/R2 Tfstate Bucket/secret accesss key }}
TF_VAR_access_owner_email={{ op://$vault/Cloudflare Access/owner email }}
TF_VAR_access_allowed_emails={{ op://$vault/Cloudflare Access/allowed emails }}
TF_VAR_access_github_client_id={{ op://$vault/Github HomelabAuth App/ClientID }}
TF_VAR_access_github_client_secret={{ op://$vault/Github HomelabAuth App/password }}
TEMPLATE
)"; then
  while IFS='=' read -r name value; do
    export "$name=${value%$'\r'}" # op.exe ends lines with CRLF
  done <<<"$env"

  export AWS_ENDPOINT_URL_S3="https://$CLOUDFLARE_ACCOUNT_ID.r2.cloudflarestorage.com"
else
  log_error "homelab: couldn't read Cloudflare credentials from 1Password; tofu will fail. Run 'direnv reload' to retry."
fi
