{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "dependencyDashboard": true,
  "nix": { "enabled": true },
  "lockFileMaintenance": { "enabled": true },
  "argocd": {
    "managerFilePatterns": ["/^apps/.+\\.ya?ml$/"]
  },
  "kubernetes": {
    "managerFilePatterns": ["/^manifests/.+\\.ya?ml$/"]
  },
  "packageRules": [
    {
      "description": "Lint CI Python: stay within what the pinned ansible-core supports (2.21: <=3.14); raise with ansible-core",
      "matchManagers": ["github-actions"],
      "matchDepNames": ["python"],
      "allowedVersions": "<3.15"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Versions pinned with a `# renovate:` comment in Ansible role defaults and workflow env",
      "managerFilePatterns": ["/^ansible/.+/defaults/main\\.ya?ml$/", "/^\\.github/workflows/.+\\.ya?ml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)( extractVersion=(?<extractVersion>\\S+))?( versioning=(?<versioning>\\S+))?\\s+\\w+: \"?(?<currentValue>[^\"\\s]+)\"?"
      ],
      "extractVersionTemplate": "{{#if extractVersion}}{{{extractVersion}}}{{/if}}",
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver-coerced{{/if}}"
    }
  ]
}
